DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set to a Neon PostgreSQL connection string to use Postgres instead of the SQLite dev default.
# Format: postgresql://<user>:<password>@<host>/<dbname>
# DATABASE_URL=

# Required in production (DEBUG=False) — origins allowed to POST here, e.g. https://your-app.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Cloudinary media storage — leave all unset for local dev (falls back to MEDIA_ROOT on disk).
# Render's free tier has no persistent disk, so production needs these set to keep uploaded media
# (Resume PDF, ProjectImage screenshots) across redeploys. (Cloudflare R2 was the original plan but
# requires a card on file to activate; Cloudinary's free tier needs none.)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
