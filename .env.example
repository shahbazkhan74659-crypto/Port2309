DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set to a Neon PostgreSQL connection string to use Postgres instead of the SQLite dev default.
# Format: postgresql://<user>:<password>@<host>/<dbname>
# DATABASE_URL=

# Required in production (DEBUG=False) — origins allowed to POST here, e.g. https://your-app.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Cloudflare R2 (S3-compatible) media storage — leave all unset for local dev (falls back to MEDIA_ROOT on disk).
# Render's free tier has no persistent disk, so production needs these set to keep uploaded media
# (Resume PDF, ProjectImage screenshots) across redeploys.
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_DOMAIN=pub-xxxxxxxx.r2.dev
